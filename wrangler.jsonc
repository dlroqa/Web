{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lightagent-control",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",

  // HTML documents and the API run through the Worker so every document gets
  // a fresh CSP nonce. Content-hashed build output under /assets/* is served
  // directly by the asset service. Missing assets are 404s, never the SPA
  // shell; the Worker performs the SPA fallback itself (with CSP).
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*"]
  },

  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },

  // Public, non-secret configuration only. Secrets are set with
  // `wrangler secret put` (staging/production) or .dev.vars (local).
  // `vars` and `ratelimits` are not inherited by named environments, so each
  // environment repeats them with its own values.
  "vars": {
    "ENVIRONMENT": "development",
    "TRUSTED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
    "HSTS_MAX_AGE": "0",
    "TURNSTILE_EXPECTED_HOSTNAMES": "localhost,127.0.0.1",
    // Exact public origin (Better Auth baseURL, OAuth callbacks, passkey origin).
    "PUBLIC_ORIGIN": "http://localhost:5173",
    // WebAuthn relying-party id: the public origin's hostname, never a wildcard.
    "PASSKEY_RP_ID": "localhost",
    // "open": first sign-in creates an active account. "approval": pending until an operator activates it.
    "SIGNUP_POLICY": "open",
    // Cloudflare's public always-pass test site key; development only.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },

  // D1: one database per environment. Database ids are not secrets. Each
  // environment binds only its own database; d1_databases is not inherited.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lightagent-control-dev",
      "database_id": "773b82f0-29e6-446e-9d26-6394d0837596",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare rate limiters, one per policy. namespace_id is account-scoped,
  // so each environment uses its own range to keep counters separate.
  "ratelimits": [
        { "name": "RL_LOGIN", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_SIGNUP", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_RECOVERY", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } },
        { "name": "RL_PROVISION", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_READ", "namespace_id": "1005", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_PASSKEY_LOGIN", "namespace_id": "1006", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_SECURITY_WRITE", "namespace_id": "1007", "simple": { "limit": 20, "period": 60 } }
      ],

  "env": {
    "staging": {
      "name": "lightagent-control-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "TRUSTED_ORIGINS": "https://lightagent-control-staging.eddelaroca.workers.dev",
        "HSTS_MAX_AGE": "0",
        "TURNSTILE_EXPECTED_HOSTNAMES": "lightagent-control-staging.eddelaroca.workers.dev",
        "PUBLIC_ORIGIN": "https://lightagent-control-staging.eddelaroca.workers.dev",
        "PASSKEY_RP_ID": "lightagent-control-staging.eddelaroca.workers.dev",
        "SIGNUP_POLICY": "approval",
        // Public site key of the staging-only widget (hostname-restricted).
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFNMfAUq5o1WPhrX"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lightagent-control-staging",
          "database_id": "3cc0724d-fb83-4477-ac0f-5aee58606fdf",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "RL_LOGIN", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_SIGNUP", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_RECOVERY", "namespace_id": "2003", "simple": { "limit": 3, "period": 60 } },
        { "name": "RL_PROVISION", "namespace_id": "2004", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_READ", "namespace_id": "2005", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_PASSKEY_LOGIN", "namespace_id": "2006", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_SECURITY_WRITE", "namespace_id": "2007", "simple": { "limit": 20, "period": 60 } }
      ]
    },
    "production": {
      "name": "lightagent-control-production",
      // TRUSTED_ORIGINS and TURNSTILE_EXPECTED_HOSTNAMES stay empty until the
      // production hostname is approved; empty fails closed (all state-changing
      // requests and all Turnstile checks are rejected).
      "vars": {
        "ENVIRONMENT": "production",
        "TRUSTED_ORIGINS": "",
        "HSTS_MAX_AGE": "0",
        "TURNSTILE_EXPECTED_HOSTNAMES": "",
        // Empty until the production hostname is approved: sign-in is disabled.
        "PUBLIC_ORIGIN": "",
        "PASSKEY_RP_ID": "",
        "SIGNUP_POLICY": "approval",
        "TURNSTILE_SITE_KEY": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lightagent-control-production",
          "database_id": "581f46bc-733c-4d9f-87c9-a5bb90716986",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "RL_LOGIN", "namespace_id": "3001", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_SIGNUP", "namespace_id": "3002", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_RECOVERY", "namespace_id": "3003", "simple": { "limit": 3, "period": 60 } },
        { "name": "RL_PROVISION", "namespace_id": "3004", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_READ", "namespace_id": "3005", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_PASSKEY_LOGIN", "namespace_id": "3006", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_SECURITY_WRITE", "namespace_id": "3007", "simple": { "limit": 20, "period": 60 } }
      ]
    }
  }
}
