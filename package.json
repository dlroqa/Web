{
  "name": "lightagent-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Identity and provisioning control plane for the Lightagent agent harness.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --project workers --project static --project client",
    "cf-typegen": "wrangler types",
    "check": "npm run typecheck && npm test && npm run build && npm run test:build",
    "test:build": "vitest run --project build",
    "protocol:verify": "node scripts/verify-frozen-protocol.mjs && sha256sum --check --strict protocol/la-web-provisioning-1/MANIFEST.sha256",
    "ci:cloudflare": "npm run protocol:verify && npm run typecheck && npm test && npm run build && npm run test:build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "operator": "esbuild src/operator/main.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/lightagent/operator.mjs && node node_modules/.cache/lightagent/operator.mjs",
    "auth:schema": "esbuild scripts/auth-schema.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/lightagent/auth-schema.mjs && node node_modules/.cache/lightagent/auth-schema.mjs",
    "protocol:fixtures": "esbuild scripts/provisioning-fixtures.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/lightagent/provisioning-fixtures.mjs && node node_modules/.cache/lightagent/provisioning-fixtures.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@simplewebauthn/browser": "13.3.0",
    "better-auth": "1.7.7",
    "better-call": "1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true,
    "workerd@1.20260815.1": true
  }
}
