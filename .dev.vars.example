# Copy to .dev.vars for local development. .dev.vars is gitignored.
# Use development-only values. Never put staging or production secrets here.
# Production/staging secrets: `wrangler secret put <NAME> --env <env>`.

# 32+ random bytes, base64 (e.g. `openssl rand -base64 48`). Different per environment.
BETTER_AUTH_SECRET=
# Development: Cloudflare's always-pass test secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LIGHTAGENT_SIGNING_PRIVATE_KEY=
# Keyed hash for audit source addresses (32+ random bytes, base64). Optional;
# when unset, audit events carry no source hash.
AUDIT_SOURCE_HMAC_KEY=
